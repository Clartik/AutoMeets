<UserControl x:Class="AutoMeetsUI.SetupControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AutoMeetsUI"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Border Padding="5" Background="White" Visibility="{Binding ApplicationViewModel.MainWindowLightVisibility, Source={x:Static local:ViewModelLocator.Instance}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Border Padding="5">
                        <Button x:Name="BackButton"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="{StaticResource FontAwesomeRightBackArrowIcon}"
                                FontFamily="{StaticResource FontAwesome}"
                                Style="{StaticResource IconNormalButton}"
                                Command="{Binding BackCommand}"
                                />
                                <!--ToolTip="Return to the Home Page"-->
                    </Border>

                    <TextBlock x:Name="Title"
                               Text="Setup"
                               FontSize="30"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Padding="5"
                               />
                </Grid>

                <Border Padding="10" Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- First Half 1 to 3-->
                            <StackPanel Grid.Column="0">
                                <!-- Info -->
                                <StackPanel Visibility="{Binding InfoVisibility}">
                                    <TextBlock x:Name="InfoTitle"
                                           Text="Your Personal Information"
                                           FontSize="15"
                                           Padding="5"
                                           Foreground="Gray"
                                           VerticalAlignment="Center"
                                           />

                                    <!-- Gmail Info -->
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="GmailText"
                                               Text="School Email:"
                                               Padding="5"
                                               VerticalAlignment="Center"
                                               />
                                        <TextBox x:Name="EmailInput"
                                             Text="{Binding Email}"
                                             Width="175"
                                             Background="LightGray"
                                             VerticalAlignment="Center"
                                             />
                                    </StackPanel>

                                    <!-- Password -->
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="PasswordText"
                                               Text="School Password:"
                                               Padding="5"
                                               VerticalAlignment="Center"
                                               />
                                        <TextBox x:Name="PasswordInput"
                                             Text="{Binding Password}"
                                             Width="175"
                                             Background="LightGray"
                                             VerticalAlignment="Center"
                                             />
                                    </StackPanel>

                                    <!-- Confirm Password -->
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="ConfirmPasswordText"
                                               Text="Confirm School Password:"
                                               Padding="5"
                                               VerticalAlignment="Center"
                                                   ToolTip="Retype your Password"
                                               />
                                        <TextBox x:Name="ConfirmPasswordInput"
                                             Text="{Binding ConfirmPassword}"
                                             Width="175"
                                             Background="LightGray"
                                             VerticalAlignment="Center"
                                             />
                                    </StackPanel>

                                    <Separator Height="8"
                                           Background="Transparent"
                                           />
                                </StackPanel>

                                <StackPanel Visibility="{Binding LeftPeriodVisibility}">
                                    <StackPanel>
                                        <TextBlock x:Name="Period0Title"
                                                Text="Zero Period"
                                                FontSize="15"
                                                Padding="5"
                                                Foreground="Gray"
                                                />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Do you have a Zero Period?"
                                                       Padding="5"
                                                       VerticalAlignment="Center"
                                                       />
                                        <Border Padding="2">
                                            <ToggleButton Content="Yes"
                                                    Padding="8 5"
                                                          VerticalAlignment="Center"
                                                    IsChecked="{Binding ZeroYesChecked}"
                                                    Command="{Binding ZeroYesCommand}"
                                                    />
                                        </Border>
                                        <Border Padding="2">
                                            <ToggleButton Content="No"
                                                        Padding="8 5"
                                                          VerticalAlignment="Center"
                                                        IsChecked="{Binding ZeroNoChecked}"
                                                        Command="{Binding ZeroNoCommand}"
                                                        />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding Per0Visibility}">
                                        <!-- Period 0 Name -->
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="Period0NameText"
                                                    Text="Zero Period Name:"
                                                    Padding="5"
                                                    VerticalAlignment="Center"
                                                    />
                                            <TextBox x:Name="Period0NameInput"
                                                 Text="{Binding Per0Name}"
                                                 Width="175"
                                                 Background="LightGray"
                                                 VerticalAlignment="Center"
                                                 />
                                        </StackPanel>
                                        <!-- Period 0 Meet Code -->
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="Period0CodeText"
                                                    Text="Zero Period Meet Code/Link:"
                                                    Padding="5"
                                                    VerticalAlignment="Center"
                                                    />
                                            <TextBox x:Name="Period0CodeInput"
                                                 Text="{Binding Per0Code}"
                                                 Width="150"
                                                 Background="LightGray"
                                                 VerticalAlignment="Center"
                                                 />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Period 1 -->
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="Period1Title"
                                                    Text="Period 1"
                                                    FontSize="15"
                                                    Padding="5"
                                                       VerticalAlignment="Center"
                                                    Foreground="Gray"
                                                    />
                                            <Border Padding="2">
                                                <ToggleButton Content="Skip"
                                                              Padding="5"
                                                              Foreground="Black"
                                                              Background="LightGray"
                                                              VerticalAlignment="Center"
                                                              IsChecked="{Binding Per1SkipChecked}"
                                                              Command="{Binding Per1SkipCommand}"
                                                              ToolTip="Is Period 1 a Free Period?"
                                                              />
                                            </Border>
                                        </StackPanel>

                                        <!-- Period 1 Name -->
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding Per1MainVisibility}">
                                            <TextBlock x:Name="Period1NameText"
                                                    Text="Period 1 Name:"
                                                    Padding="5"
                                                    VerticalAlignment="Center"
                                                    />
                                            <TextBox x:Name="Period1NameInput"
                                                 Text="{Binding Per1Name}"
                                                 Width="175"
                                                 Background="LightGray"
                                                 VerticalAlignment="Center"
                                                 />
                                        </StackPanel>
                                        <!-- Period 1 Meet Code -->
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="Period1CodeText"
                                                    Text="Period 1 Meet Code/Link:"
                                                    Padding="5"
                                                    VerticalAlignment="Center"
                                                    />
                                            <TextBox x:Name="Period1CodeInput"
                                                 Text="{Binding Per1Code}"
                                                 Width="150"
                                                 Background="LightGray"
                                                 VerticalAlignment="Center"
                                                 />
                                        </StackPanel>
                                    </StackPanel>
                                    <!-- Period 2 -->
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="Period2Title"
                                                    Text="Period 2"
                                                    FontSize="15"
                                                    Padding="5"
                                                       VerticalAlignment="Center"
                                                    Foreground="Gray"
                                                    />
                                            <Border Padding="2">
                                                <ToggleButton Content="Skip"
                                                              Padding="5"
                                                              Foreground="Black"
                                                              Background="LightGray"
                                                              VerticalAlignment="Center"
                                                              IsChecked="{Binding Per2SkipChecked}"
                                                              Command="{Binding Per2SkipCommand}"
                                                              ToolTip="Is Period 2 a Free Period?"
                                                              />
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Visibility="{Binding Per2MainVisibility}">
                                            <!-- Period 2 Name -->
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="Period2NameText"
                                            Text="Period 2 Name:"
                                            Padding="5"
                                            VerticalAlignment="Center"
                                            />
                                                <TextBox x:Name="Period2NameInput"
                                                 Text="{Binding Per2Name}"
                                             Width="175"
                                             Background="LightGray"
                                             VerticalAlignment="Center"
                                             />
                                            </StackPanel>
                                            <!-- Period 2 Meet Code -->
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="Period2CodeText"
                                            Text="Period 2 Meet Code/Link:"
                                            Padding="5"
                                            VerticalAlignment="Center"
                                            />
                                                <TextBox x:Name="Period2CodeInput"
                                                 Text="{Binding Per2Code}"
                                             Width="150"
                                             Background="LightGray"
                                             VerticalAlignment="Center"
                                             />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                    <!-- Period 3 -->
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="Period3Title"
                                                    Text="Period 3"
                                                    FontSize="15"
                                                    Padding="5"
                                                       VerticalAlignment="Center"
                                                    Foreground="Gray"
                                                    />
                                            <Border Padding="2">
                                                <ToggleButton Content="Skip"
                                                              Padding="5"
                                                              Foreground="Black"
                                                              Background="LightGray"
                                                              VerticalAlignment="Center"
                                                              IsChecked="{Binding Per3SkipChecked}"
                                                              Command="{Binding Per3SkipCommand}"
                                                              ToolTip="Is Period 3 a Free Period?"
                                                              />
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Visibility="{Binding Per3MainVisibility}">
                                            <!-- Period 3 Name -->
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="Period3NameText"
                                            Text="Period 3 Name:"
                                            Padding="5"
                                            VerticalAlignment="Center"
                                            />
                                                <TextBox x:Name="Period3NameInput"
                                                 Text="{Binding Per3Name}"
                                             Width="175"
                                             Background="LightGray"
                                             VerticalAlignment="Center"
                                             />
                                            </StackPanel>
                                            <!-- Period 3 Meet Code -->
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="Period3CodeText"
                                                    Text="Period 3 Meet Code/Link:"
                                                    Padding="5"
                                                    VerticalAlignment="Center"
                                                    />
                                                <TextBox x:Name="Period3CodeInput"
                                                 Text="{Binding Per3Code}"
                                                 Width="150"
                                                 Background="LightGray"
                                                 VerticalAlignment="Center"
                                                 />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                <!-- Friday -->
                                <StackPanel Visibility="{Binding FridayVisibility}">
                                    <TextBlock x:Name="FridayTitle"
                                               Text="Friday"
                                               FontSize="15"
                                               Padding="5"
                                               Foreground="Gray"
                                               />

                                    <!-- Friday Text and Options -->
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="FridayText"
                                                            Text="Which class do you have this Friday?"
                                                            Padding="5"
                                                            VerticalAlignment="Top"
                                                            />

                                        <!-- Padding between buttons -->
                                        <StackPanel Orientation="Vertical">
                                            <Border Padding="2">
                                                <ToggleButton x:Name="FridayP1Button"
                                                    Content="Per 1"
                                                    Padding="5"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding FridayPer1Command}"
                                                          IsChecked="{Binding FridayPer1Checked}"
                                                    />
                                            </Border>
                                            <Border Padding="2">
                                                <ToggleButton x:Name="FridayP4Button"
                                                        Content="Per 4"
                                                        Padding="5"
                                                        VerticalAlignment="Center"
                                                    Command="{Binding FridayPer4Command}"
                                                          IsChecked="{Binding FridayPer4Checked}"
                                                        />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Vertical">
                                            <Border Padding="2">
                                                <ToggleButton x:Name="FridayP2Button"
                                                        Content="Per 2"
                                                        Padding="5"
                                                        VerticalAlignment="Center"
                                                    Command="{Binding FridayPer2Command}"
                                                          IsChecked="{Binding FridayPer2Checked}"
                                                        />
                                            </Border>
                                            <Border Padding="2">
                                                <ToggleButton x:Name="FridayP5Button"
                                                        Content="Per 5"
                                                        Padding="5"
                                                        VerticalAlignment="Center"
                                                    Command="{Binding FridayPer5Command}"
                                                          IsChecked="{Binding FridayPer5Checked}"
                                                        />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Vertical">
                                            <Border Padding="2">
                                                <ToggleButton x:Name="FridayP3Button"
                                                    Content="Per 3"
                                                    Padding="5"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding FridayPer3Command}"
                                                          IsChecked="{Binding FridayPer3Checked}"
                                                     />
                                            </Border>
                                            <Border Padding="2">
                                                <ToggleButton x:Name="FridayP6Button"
                                                        Content="Per 6"
                                                        Padding="5"
                                                        VerticalAlignment="Center"
                                                    Command="{Binding FridayPer6Command}"
                                                          IsChecked="{Binding FridayPer6Checked}"
                                                        />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- Second Half 4 to 6-->
                            <StackPanel Grid.Column="1">
                                <!-- Week Schedule -->
                                <StackPanel Visibility="{Binding WeekVisibility}">
                                    <TextBlock x:Name="WeekScheduleTitle"
                                   Text="This Week's Schedule"
                                   FontSize="15"
                                   Padding="5"
                                   Foreground="Gray"
                                   />
                                    <!-- Odd or Even Week Start -->
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="OddorEvenText"
                                           Text="How does this week start?"
                                           Padding="5"
                                           VerticalAlignment="Center"
                                                   ToolTip="Does This Week Start with a 1-3-5 day or a 2-4-6 day?"
                                           />
                                        <!-- Buttons with Padding -->
                                        <StackPanel Orientation="Horizontal">
                                            <Border Padding="2">
                                                <ToggleButton x:Name="OddButton"
                                                          Content="Odd"
                                                          Padding="5"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding OddChecked}"
                                                          Command="{Binding OddCommand}"
                                                              ToolTip="This Week Starts with a 1-3-5 Day"
                                                          />
                                            </Border>
                                            <Border Padding="2">
                                                <ToggleButton x:Name="EvenButton"
                                                          Content="Even"
                                                          Padding="5"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding EvenChecked}"
                                                          Command="{Binding EvenCommand}"
                                                              ToolTip="This Week Starts with a 2-4-6 Day"
                                                          />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <!-- Days Off -->
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock x:Name="DaysOffText"
                                           Text="Which days do you not have school on?"
                                           Padding="5"
                                           VerticalAlignment="Top"
                                           />
                                        <StackPanel Orientation="Horizontal">
                                            <Border Padding="2">
                                                <ToggleButton x:Name="MondayButton"
                                                          Content="Monday"
                                                          Padding="5"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding MondayChecked}"
                                                          IsEnabled="{Binding MondayEnabled}"
                                                          />
                                            </Border>
                                            <Border Padding="2">
                                                <ToggleButton x:Name="TuesdayButton"
                                                          Content="Tuesday"
                                                          Padding="5"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding TuesdayChecked}"
                                                          IsEnabled="{Binding TuesdayEnabled}"
                                                          />
                                            </Border>
                                            <Border Padding="2">
                                                <ToggleButton x:Name="WednesdayButton"
                                                          Content="Wednesday"
                                                          Padding="5"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding WednesdayChecked}"
                                                          IsEnabled="{Binding WednesdayEnabled}"
                                                          />
                                            </Border>
                                            <Border Padding="2">
                                                <ToggleButton x:Name="ThursdayButton"
                                                          Content="Thursday"
                                                          Padding="5"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding ThursdayChecked}"
                                                          IsEnabled="{Binding ThursdayEnabled}"
                                                          />
                                            </Border>
                                            <Border Padding="2">
                                                <ToggleButton x:Name="FridayButton"
                                                          Content="Friday"
                                                          Padding="5"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding FridayChecked}"
                                                          IsEnabled="{Binding FridayEnabled}"
                                                          />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <Grid Visibility="{Binding SaturdayWeeklyVisibility}">
                                    <TextBlock Text="Weekly Schedules cannot be changed on Saturdays."
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           />
                                    <Separator Height="116" Background="Transparent" />
                                </Grid>

                                <StackPanel Visibility="{Binding RightPeriodVisibility}">
                                    <!-- Period 4 -->
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="Period4Title"
                                                    Text="Period 4"
                                                    FontSize="15"
                                                    Padding="5"
                                                       VerticalAlignment="Center"
                                                    Foreground="Gray"
                                                    />
                                            <Border Padding="2">
                                                <ToggleButton Content="Skip"
                                                              Padding="5"
                                                              Foreground="Black"
                                                              Background="LightGray"
                                                              VerticalAlignment="Center"
                                                              IsChecked="{Binding Per4SkipChecked}"
                                                              Command="{Binding Per4SkipCommand}"
                                                              ToolTip="Is Period 4 a Free Period?"
                                                              />
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Visibility="{Binding Per4MainVisibility}">
                                            <!-- Period 4 Name -->
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="Period4NameText"
                                                            Text="Period 4 Name:"
                                                            Padding="5"
                                                            VerticalAlignment="Center"
                                                            />
                                                <TextBox x:Name="Period4NameInput"
                                                         Text="{Binding Per4Name}"
                                                         Width="175"
                                                         Background="LightGray"
                                                         VerticalAlignment="Center"
                                                         />
                                            </StackPanel>
                                            <!-- Period 4 Meet Code -->
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="Period4CodeText"
                                                            Text="Period 4 Meet Code/Link:"
                                                            Padding="5"
                                                            VerticalAlignment="Center"
                                                            />
                                                <TextBox x:Name="Period4CodeInput"
                                                         Text="{Binding Per4Code}"
                                                         Width="150"
                                                         Background="LightGray"
                                                         VerticalAlignment="Center"
                                                         />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                    <!-- Period 5 -->
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="Period5Title"
                                                    Text="Period 5"
                                                    FontSize="15"
                                                    Padding="5"
                                                       VerticalAlignment="Center"
                                                    Foreground="Gray"
                                                    />
                                            <Border Padding="2">
                                                <ToggleButton Content="Skip"
                                                              Padding="5"
                                                              Foreground="Black"
                                                              Background="LightGray"
                                                              VerticalAlignment="Center"
                                                              IsChecked="{Binding Per5SkipChecked}"
                                                              Command="{Binding Per5SkipCommand}"
                                                              ToolTip="Is Period 5 a Free Period?"
                                                              />
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Visibility="{Binding Per5MainVisibility}">
                                            <!-- Period 5 Name -->
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="Period5NameText"
                                            Text="Period 5 Name:"
                                            Padding="5"
                                            VerticalAlignment="Center"
                                            />
                                                <TextBox x:Name="Period5NameInput"
                                                 Text="{Binding Per5Name}"
                                             Width="175"
                                             Background="LightGray"
                                             VerticalAlignment="Center"
                                             />
                                            </StackPanel>
                                            <!-- Period 5 Meet Code -->
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="Period5CodeText"
                                            Text="Period 5 Meet Code/Link:"
                                            Padding="5"
                                            VerticalAlignment="Center"
                                            />
                                                <TextBox x:Name="Period5CodeInput"
                                                 Text="{Binding Per5Code}"
                                             Width="150"
                                             Background="LightGray"
                                             VerticalAlignment="Center"
                                             />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                    <!-- Period 6 -->
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="Period6Title"
                                                    Text="Period 6"
                                                    FontSize="15"
                                                    Padding="5"
                                                       VerticalAlignment="Center"
                                                    Foreground="Gray"
                                                    />
                                            <Border Padding="2">
                                                <ToggleButton Content="Skip"
                                                              Padding="5"
                                                              Foreground="Black"
                                                              Background="LightGray"
                                                              VerticalAlignment="Center"
                                                              IsChecked="{Binding Per6SkipChecked}"
                                                              Command="{Binding Per6SkipCommand}"
                                                              ToolTip="Is Period 6 a Free Period?"
                                                              />
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Visibility="{Binding Per6MainVisibility}">
                                            <!-- Period 6 Name -->
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="Period6NameText"
                                            Text="Period 6 Name:"
                                            Padding="5"
                                            VerticalAlignment="Center"
                                            />
                                                <TextBox x:Name="Period6NameInput"
                                                 Text="{Binding Per6Name}"
                                             Width="175"
                                             Background="LightGray"
                                             VerticalAlignment="Center"
                                             />
                                            </StackPanel>
                                            <!-- Period 6 Meet Code -->
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="Period6CodeText"
                                            Text="Period 6 Meet Code/Link:"
                                            Padding="5"
                                            VerticalAlignment="Center"
                                            />
                                                <TextBox x:Name="Period6CodeInput"
                                                 Text="{Binding Per6Code}"
                                             Width="150"
                                             Background="LightGray"
                                             VerticalAlignment="Center"
                                             />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Row="2">
                    <Button x:Name="Save"
                            Content="Save"
                            Padding="10 5"
                            IsEnabled="True"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Center"
                            Command="{Binding SaveCommand}"
                            local:IsBusyProperty.Value="{Binding SaveIsRunning}"
                            Style="{StaticResource IsBusySaveButton}"
                            ToolTip="Save All Changes on the Setup Page"
                            />
                </Grid>
            </Grid>
        </Border>
        <Border Padding="5" Background="{StaticResource DarkModeBackgroundBrush}" Visibility="{Binding ApplicationViewModel.MainWindowDarkVisibility, Source={x:Static local:ViewModelLocator.Instance}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Border Padding="5">
                        <Button x:Name="BackButtonDark"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Content="{StaticResource FontAwesomeRightBackArrowIcon}"
                            FontFamily="{StaticResource FontAwesome}"
                            Style="{StaticResource IconNormalDarkButton}"
                            Command="{Binding BackCommand}"
                            Foreground="White"
                            ToolTip="Return to the Home Page"
                            />
                    </Border>

                    <TextBlock x:Name="TitleDark"
                               Text="Setup"
                               FontSize="30"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Padding="5"
                               Foreground="{StaticResource AutoMeetsYellowBrush}"
                               />
                </Grid>

                <Border Padding="10" Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- First Half 1 to 3-->
                            <StackPanel Grid.Column="0">
                                <!-- Info -->
                                <StackPanel Visibility="{Binding InfoVisibility}">
                                    <TextBlock x:Name="InfoTextDark"
                                           Text="Your Personal Information"
                                           FontSize="15"
                                           Padding="5"
                                           Foreground="LightGray"
                                           VerticalAlignment="Center"
                                           />

                                    <!-- Gmail Info -->
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="GmailTextDark"
                                               Text="School Email:"
                                               Padding="5"
                                               VerticalAlignment="Center"
                                                   Foreground="White"
                                               />
                                        <TextBox x:Name="EmailInputDark"
                                             Text="{Binding Email}"
                                             Width="175"
                                             Background="LightGray"
                                             VerticalAlignment="Center"
                                             />
                                    </StackPanel>

                                    <!-- Password -->
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="PasswordTextDark"
                                               Text="School Password:"
                                               Padding="5"
                                               VerticalAlignment="Center"
                                                   Foreground="White"
                                               />
                                        <TextBox x:Name="PasswordInputDark"
                                             Text="{Binding Password}"
                                             Width="175"
                                             Background="LightGray"
                                             VerticalAlignment="Center"
                                             />
                                    </StackPanel>

                                    <!-- Confirm Password -->
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="ConfirmPasswordTextDark"
                                               Text="Confirm School Password:"
                                               Padding="5"
                                               VerticalAlignment="Center"
                                                   Foreground="White"
                                               />
                                        <TextBox x:Name="ConfirmPasswordInputDark"
                                             Text="{Binding ConfirmPassword}"
                                             Width="175"
                                             Background="LightGray"
                                             VerticalAlignment="Center"
                                             />
                                    </StackPanel>

                                    <Separator Height="8"
                                           Background="Transparent"
                                           />
                                </StackPanel>

                                <StackPanel Visibility="{Binding LeftPeriodVisibility}">
                                    <StackPanel>
                                        <TextBlock x:Name="Period0TitleDark"
                                                Text="Zero Period"
                                                FontSize="15"
                                                Padding="5"
                                                Foreground="LightGray"
                                                />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Do you have a Zero Period?"
                                                       Padding="5"
                                                       VerticalAlignment="Center"
                                                       Foreground="White"
                                                       />
                                        <Border Padding="2">
                                            <ToggleButton Content="Yes"
                                                    Padding="8 5"
                                                          VerticalAlignment="Center"
                                                    IsChecked="{Binding ZeroYesChecked}"
                                                    Command="{Binding ZeroYesCommand}"
                                                    />
                                        </Border>
                                        <Border Padding="2">
                                            <ToggleButton Content="No"
                                                        Padding="8 5"
                                                          VerticalAlignment="Center"
                                                        IsChecked="{Binding ZeroNoChecked}"
                                                        Command="{Binding ZeroNoCommand}"
                                                        />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding Per0Visibility}">
                                        <!-- Period 0 Name -->
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="Period0NameTextDark"
                                                    Text="Zero Period Name:"
                                                    Padding="5"
                                                    VerticalAlignment="Center"
                                                       Foreground="White"
                                                    />
                                            <TextBox x:Name="Period0NameInputDark"
                                                 Text="{Binding Per0Name}"
                                                 Width="175"
                                                 Background="LightGray"
                                                 VerticalAlignment="Center"
                                                 />
                                        </StackPanel>
                                        <!-- Period 0 Meet Code -->
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="Period0CodeTextDark"
                                                    Text="Zero Period Meet Code/Link:"
                                                    Padding="5"
                                                    VerticalAlignment="Center"
                                                       Foreground="White"
                                                    />
                                            <TextBox x:Name="Period0CodeInputDark"
                                                 Text="{Binding Per0Code}"
                                                 Width="150"
                                                 Background="LightGray"
                                                 VerticalAlignment="Center"
                                                 />
                                        </StackPanel>
                                    </StackPanel>
                                    
                                    <!-- Period 1 -->
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="Period1TitleDark"
                                                    Text="Period 1"
                                                    FontSize="15"
                                                    Padding="5"
                                                       VerticalAlignment="Center"
                                                    Foreground="LightGray"
                                                    />
                                            <Border Padding="2">
                                                <ToggleButton Content="Skip"
                                                              Padding="5"
                                                              Foreground="Black"
                                                              Background="LightGray"
                                                              VerticalAlignment="Center"
                                                              IsChecked="{Binding Per1SkipChecked}"
                                                              Command="{Binding Per1SkipCommand}"
                                                              ToolTip="Is Period 1 a Free Period?"
                                                              />
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Visibility="{Binding Per1MainVisibility}">
                                            <!-- Period 1 Name -->
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="Period1NameTextDark"
                                                    Text="Period 1 Name:"
                                                    Padding="5"
                                                    VerticalAlignment="Center"
                                                       Foreground="White"
                                                    />
                                                <TextBox x:Name="Period1NameInputDark"
                                                 Text="{Binding Per1Name}"
                                                 Width="175"
                                                 Background="LightGray"
                                                 VerticalAlignment="Center"
                                                 />
                                            </StackPanel>
                                            <!-- Period 1 Meet Code -->
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="Period1CodeTextDark"
                                                    Text="Period 1 Meet Code/Link:"
                                                    Padding="5"
                                                    VerticalAlignment="Center"
                                                       Foreground="White"
                                                    />
                                                <TextBox x:Name="Period1CodeInputDark"
                                                 Text="{Binding Per1Code}"
                                                 Width="150"
                                                 Background="LightGray"
                                                 VerticalAlignment="Center"
                                                 />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                    <!-- Period 2 -->
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="Period2TitleDark"
                                                    Text="Period 2"
                                                    FontSize="15"
                                                    Padding="5"
                                                       VerticalAlignment="Center"
                                                    Foreground="LightGray"
                                                    />
                                            <Border Padding="2">
                                                <ToggleButton Content="Skip"
                                                              Padding="5"
                                                              Foreground="Black"
                                                              Background="LightGray"
                                                              VerticalAlignment="Center"
                                                              IsChecked="{Binding Per2SkipChecked}"
                                                              Command="{Binding Per2SkipCommand}"
                                                              ToolTip="Is Period 2 a Free Period?"
                                                              />
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Visibility="{Binding Per2MainVisibility}">
                                            <!-- Period 2 Name -->
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="Period2NameTextDark"
                                            Text="Period 2 Name:"
                                            Padding="5"
                                            VerticalAlignment="Center"
                                                       Foreground="White"
                                            />
                                                <TextBox x:Name="Period2NameInputDark"
                                                 Text="{Binding Per2Name}"
                                             Width="175"
                                             Background="LightGray"
                                             VerticalAlignment="Center"
                                             />
                                            </StackPanel>
                                            <!-- Period 2 Meet Code -->
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="Period2CodeTextDark"
                                            Text="Period 2 Meet Code/Link:"
                                            Padding="5"
                                            VerticalAlignment="Center"
                                                       Foreground="White"
                                            />
                                                <TextBox x:Name="Period2CodeInputDark"
                                                 Text="{Binding Per2Code}"
                                             Width="150"
                                             Background="LightGray"
                                             VerticalAlignment="Center"
                                             />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                    <!-- Period 3 -->
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="Period3TitleDark"
                                                    Text="Period 3"
                                                    FontSize="15"
                                                    Padding="5"
                                                       VerticalAlignment="Center"
                                                    Foreground="LightGray"
                                                    />
                                            <Border Padding="2">
                                                <ToggleButton Content="Skip"
                                                              Padding="5"
                                                              Foreground="Black"
                                                              Background="LightGray"
                                                              VerticalAlignment="Center"
                                                              IsChecked="{Binding Per3SkipChecked}"
                                                              Command="{Binding Per3SkipCommand}"
                                                              ToolTip="Is Period 3 a Free Period?"
                                                              />
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Visibility="{Binding Per3MainVisibility}">
                                            <!-- Period 3 Name -->
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="Period3NameTextDark"
                                            Text="Period 3 Name:"
                                            Padding="5"
                                            VerticalAlignment="Center"
                                                       Foreground="White"
                                            />
                                                <TextBox x:Name="Period3NameInputDark"
                                                 Text="{Binding Per3Name}"
                                             Width="175"
                                             Background="LightGray"
                                             VerticalAlignment="Center"
                                             />
                                            </StackPanel>
                                            <!-- Period 3 Meet Code -->
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="Period3CodeTextDark"
                                                    Text="Period 3 Meet Code/Link:"
                                                    Padding="5"
                                                    VerticalAlignment="Center"
                                                       Foreground="White"
                                                    />
                                                <TextBox x:Name="Period3CodeInputDark"
                                                 Text="{Binding Per3Code}"
                                                 Width="150"
                                                 Background="LightGray"
                                                 VerticalAlignment="Center"
                                                 />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                <!-- Friday -->
                                <StackPanel Visibility="{Binding FridayVisibility}">
                                    <TextBlock x:Name="FridayTitleDark"
                                               Text="Friday"
                                               FontSize="15"
                                               Padding="5"
                                               Foreground="LightGray"
                                               />

                                    <!-- Friday Text and Options -->
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="FridayTextDark"
                                                            Text="Which class do you have this Friday?"
                                                            Padding="5"
                                                            VerticalAlignment="Top"
                                                   Foreground="White"
                                                            />

                                        <!-- Padding between buttons -->
                                        <StackPanel Orientation="Vertical">
                                            <Border Padding="2">
                                                <ToggleButton x:Name="FridayP1ButtonDark"
                                                    Content="Per 1"
                                                    Padding="5"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding FridayPer1Command}"
                                                          IsChecked="{Binding FridayPer1Checked}"
                                                    />
                                            </Border>
                                            <Border Padding="2">
                                                <ToggleButton x:Name="FridayP4ButtonDark"
                                                        Content="Per 4"
                                                        Padding="5"
                                                        VerticalAlignment="Center"
                                                    Command="{Binding FridayPer4Command}"
                                                          IsChecked="{Binding FridayPer4Checked}"
                                                        />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Vertical">
                                            <Border Padding="2">
                                                <ToggleButton x:Name="FridayP2ButtonDark"
                                                        Content="Per 2"
                                                        Padding="5"
                                                        VerticalAlignment="Center"
                                                    Command="{Binding FridayPer2Command}"
                                                          IsChecked="{Binding FridayPer2Checked}"
                                                        />
                                            </Border>
                                            <Border Padding="2">
                                                <ToggleButton x:Name="FridayP5ButtonDark"
                                                        Content="Per 5"
                                                        Padding="5"
                                                        VerticalAlignment="Center"
                                                    Command="{Binding FridayPer5Command}"
                                                          IsChecked="{Binding FridayPer5Checked}"
                                                        />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Vertical">
                                            <Border Padding="2">
                                                <ToggleButton x:Name="FridayP3ButtonDark"
                                                    Content="Per 3"
                                                    Padding="5"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding FridayPer3Command}"
                                                          IsChecked="{Binding FridayPer3Checked}"
                                                     />
                                            </Border>
                                            <Border Padding="2">
                                                <ToggleButton x:Name="FridayP6ButtonDark"
                                                        Content="Per 6"
                                                        Padding="5"
                                                        VerticalAlignment="Center"
                                                    Command="{Binding FridayPer6Command}"
                                                          IsChecked="{Binding FridayPer6Checked}"
                                                        />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- Second Half 4 to 6-->
                            <StackPanel Grid.Column="1">
                                <!-- Week Schedule -->
                                <StackPanel Visibility="{Binding WeekVisibility}">
                                    <TextBlock x:Name="WeekScheduleTitleDark"
                                   Text="This Week's Schedule"
                                   FontSize="15"
                                   Padding="5"
                                   Foreground="LightGray"
                                   />
                                    <!-- Odd or Even Week Start -->
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="OddorEvenTextDark"
                                           Text="How does this week start?"
                                           Padding="5"
                                           VerticalAlignment="Center"
                                                   Foreground="White"
                                                   ToolTip="Does This Week Start with a 1-3-5 day or a 2-4-6 day?"
                                           />
                                        <!-- Buttons with Padding -->
                                        <StackPanel Orientation="Horizontal">
                                            <Border Padding="2">
                                                <ToggleButton x:Name="OddButtonDark"
                                                          Content="Odd"
                                                          Padding="5"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding OddChecked}"
                                                          Command="{Binding OddCommand}"
                                                              ToolTip="This Week Starts with a 1-3-5 Day"
                                                          />
                                            </Border>
                                            <Border Padding="2">
                                                <ToggleButton x:Name="EvenButtonDark"
                                                          Content="Even"
                                                          Padding="5"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding EvenChecked}"
                                                          Command="{Binding EvenCommand}"
                                                              ToolTip="This Week Starts with a 2-4-6 Day"
                                                          />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <!-- Days Off -->
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock x:Name="DaysOffTextDark"
                                           Text="Which days do you not have school on?"
                                           Padding="5"
                                           VerticalAlignment="Top"
                                                   Foreground="White"
                                           />
                                        <StackPanel Orientation="Horizontal">
                                            <Border Padding="2">
                                                <ToggleButton x:Name="MondayButtonDark"
                                                          Content="Monday"
                                                          Padding="5"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding MondayChecked}"
                                                          IsEnabled="{Binding MondayEnabled}"
                                                          />
                                            </Border>
                                            <Border Padding="2">
                                                <ToggleButton x:Name="TuesdayButtonDark"
                                                          Content="Tuesday"
                                                          Padding="5"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding TuesdayChecked}"
                                                          IsEnabled="{Binding TuesdayEnabled}"
                                                          />
                                            </Border>
                                            <Border Padding="2">
                                                <ToggleButton x:Name="WednesdayButtonDark"
                                                          Content="Wednesday"
                                                          Padding="5"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding WednesdayChecked}"
                                                          IsEnabled="{Binding WednesdayEnabled}"
                                                          />
                                            </Border>
                                            <Border Padding="2">
                                                <ToggleButton x:Name="ThursdayButtonDark"
                                                          Content="Thursday"
                                                          Padding="5"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding ThursdayChecked}"
                                                          IsEnabled="{Binding ThursdayEnabled}"
                                                          />
                                            </Border>
                                            <Border Padding="2">
                                                <ToggleButton x:Name="FridayButtonDark"
                                                          Content="Friday"
                                                          Padding="5"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding FridayChecked}"
                                                          IsEnabled="{Binding FridayEnabled}"
                                                          />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <Grid Visibility="{Binding SaturdayWeeklyVisibility}"
                                      ToolTip="Wait till Sunday or Later to Update Your Schedule">
                                    <TextBlock Text="Weekly Schedules cannot be changed on Saturdays."
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                               Foreground="White"
                                           />
                                    <Separator Height="116" Background="Transparent" />
                                </Grid>

                                <StackPanel Visibility="{Binding RightPeriodVisibility}">
                                    <!-- Period 4 -->
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="Period4TitleDark"
                                                    Text="Period 4"
                                                    FontSize="15"
                                                    Padding="5"
                                                       VerticalAlignment="Center"
                                                    Foreground="LightGray"
                                                    />
                                            <Border Padding="2">
                                                <ToggleButton Content="Skip"
                                                              Padding="5"
                                                              Foreground="Black"
                                                              Background="LightGray"
                                                              VerticalAlignment="Center"
                                                              IsChecked="{Binding Per4SkipChecked}"
                                                              Command="{Binding Per4SkipCommand}"
                                                              ToolTip="Is Period 4 a Free Period?"
                                                              />
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Visibility="{Binding Per4MainVisibility}">
                                            <!-- Period 4 Name -->
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="Period4NameTextDark"
                                                            Text="Period 4 Name:"
                                                            Padding="5"
                                                            VerticalAlignment="Center"
                                                       Foreground="White"
                                                            />
                                                <TextBox x:Name="Period4NameInputDark"
                                                         Text="{Binding Per4Name}"
                                                         Width="175"
                                                         Background="LightGray"
                                                         VerticalAlignment="Center"
                                                         />
                                            </StackPanel>
                                            <!-- Period 4 Meet Code -->
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="Period4CodeTextDark"
                                                            Text="Period 4 Meet Code/Link:"
                                                            Padding="5"
                                                       Foreground="White"
                                                            VerticalAlignment="Center"
                                                            />
                                                <TextBox x:Name="Period4CodeInputDark"
                                                         Text="{Binding Per4Code}"
                                                         Width="150"
                                                         Background="LightGray"
                                                         VerticalAlignment="Center"
                                                         />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                    <!-- Period 5 -->
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="Period5TitleDark"
                                                    Text="Period 5"
                                                    FontSize="15"
                                                    Padding="5"
                                                       VerticalAlignment="Center"
                                                    Foreground="LightGray"
                                                    />
                                            <Border Padding="2">
                                                <ToggleButton Content="Skip"
                                                              Padding="5"
                                                              Foreground="Black"
                                                              Background="LightGray"
                                                              VerticalAlignment="Center"
                                                              IsChecked="{Binding Per5SkipChecked}"
                                                              Command="{Binding Per5SkipCommand}"
                                                              ToolTip="Is Period 5 a Free Period?"
                                                              />
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Visibility="{Binding Per5MainVisibility}">
                                            <!-- Period 5 Name -->
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="Period5NameTextDark"
                                            Text="Period 5 Name:"
                                            Padding="5"
                                            VerticalAlignment="Center"
                                                       Foreground="White"
                                            />
                                                <TextBox x:Name="Period5NameInputDark"
                                                 Text="{Binding Per5Name}"
                                             Width="175"
                                             Background="LightGray"
                                             VerticalAlignment="Center"
                                             />
                                            </StackPanel>
                                            <!-- Period 5 Meet Code -->
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="Period5CodeTextDark"
                                            Text="Period 5 Meet Code/Link:"
                                            Padding="5"
                                            VerticalAlignment="Center"
                                                       Foreground="White"
                                            />
                                                <TextBox x:Name="Period5CodeInputDark"
                                                 Text="{Binding Per5Code}"
                                             Width="150"
                                             Background="LightGray"
                                             VerticalAlignment="Center"
                                             />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                    <!-- Period 6 -->
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="Period6TitleDark"
                                                    Text="Period 6"
                                                    FontSize="15"
                                                    Padding="5"
                                                       VerticalAlignment="Center"
                                                    Foreground="LightGray"
                                                    />
                                            <Border Padding="2">
                                                <ToggleButton Content="Skip"
                                                              Padding="5"
                                                              Foreground="Black"
                                                              Background="LightGray"
                                                              VerticalAlignment="Center"
                                                              IsChecked="{Binding Per6SkipChecked}"
                                                              Command="{Binding Per6SkipCommand}"
                                                              ToolTip="Is Period 6 a Free Period?"
                                                              />
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Visibility="{Binding Per6MainVisibility}">
                                            <!-- Period 6 Name -->
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="Period6NameTextDark"
                                            Text="Period 6 Name:"
                                            Padding="5"
                                            VerticalAlignment="Center"
                                                       Foreground="White"
                                            />
                                                <TextBox x:Name="Period6NameInputDark"
                                                 Text="{Binding Per6Name}"
                                             Width="175"
                                             Background="LightGray"
                                             VerticalAlignment="Center"
                                             />
                                            </StackPanel>
                                            <!-- Period 6 Meet Code -->
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="Period6CodeTextDark"
                                            Text="Period 6 Meet Code/Link:"
                                            Padding="5"
                                            VerticalAlignment="Center"
                                                       Foreground="White"
                                            />
                                                <TextBox x:Name="Period6CodeInputDark"
                                                 Text="{Binding Per6Code}"
                                             Width="150"
                                             Background="LightGray"
                                             VerticalAlignment="Center"
                                             />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Row="2">
                    <Button x:Name="SaveDark"
                        Content="Save"
                        Padding="10 5"
                            IsEnabled="True"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Center"
                        Command="{Binding SaveCommand}"
                            Background="{StaticResource AutoMeetsYellowBrush}"
                            Foreground="White"
                            local:IsBusyProperty.Value="{Binding SaveIsRunning}"
                            Style="{StaticResource IsBusySaveDarkButton}"
                            ToolTip="Save All Changes on the Setup Page"
                        />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
