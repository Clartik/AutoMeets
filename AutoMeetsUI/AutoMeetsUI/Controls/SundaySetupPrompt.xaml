<UserControl x:Class="AutoMeetsUI.SundaySetupPrompt"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AutoMeetsUI"
             mc:Ignorable="d"
             d:DataContext="{x:Static local:SundaySetupPopupMenuDesignModel.Instance}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border CornerRadius="10"
                Panel.ZIndex="1"
                Padding="12"
                Margin="5 0 0 0"
                Background="{Binding BubbleBackground, Converter={local:StringRGBToBrushConverter}}"
                Grid.Row="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="4"
                                  ShadowDepth="2"
                                  Color="Gray"
                                  />
            </Border.Effect>

            <ContentControl Content="{Binding Converter={local:PopupContentConverter}}" />
        </Border>

        <Path Grid.Row="0"
              Stroke="Black"
              Panel.ZIndex="0"
              Margin="15 0 15 0"
              Data="M 0,0 L 10,-10 L 20 0 L 0, 0"
              StrokeThickness="0"
              HorizontalAlignment="{Binding ArrowAlignment, Converter={local:HorizontalAlignmentConverter}}"
              Fill="{Binding BubbleBackground, Converter={local:StringRGBToBrushConverter}}">
            <Path.Effect>
                <DropShadowEffect BlurRadius="3" ShadowDepth="3" Color="Gray" />
            </Path.Effect>
        </Path>
    </Grid>
</UserControl>
