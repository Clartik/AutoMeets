<UserControl x:Class="AutoMeetsUI.HelpControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AutoMeetsUI"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Border Padding="5" Background="White" Visibility="{Binding ApplicationViewModel.MainWindowLightVisibility, Source={x:Static local:ViewModelLocator.Instance}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Border Padding="5">
                        <Button x:Name="BackButton"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Content="{StaticResource FontAwesomeUpBackArrowIcon}"
                            FontFamily="{StaticResource FontAwesome}"
                        Style="{StaticResource IconNormalButton}"
                        Command="{Binding BackCommand}"
                            ToolTip="Return to the Home Page"
                        />
                    </Border>

                    <TextBlock x:Name="Title"
                           Text="Help"
                           FontSize="30"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Padding="5"
                           />
                </Grid>

                <Border Padding="10" Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <StackPanel>
                            <StackPanel>
                                <TextBlock Text="Welcome!"
                                       FontSize="15"
                                       Padding="5"
                                       Foreground="Gray"
                                       />
                                <TextBlock Text="Welcome to AutoMeets! AutoMeets is a program designed to make your life easier with logging you into school every day. AutoMeets was designed by Kartik Yedumbaka in association with Mahavir Dondeti. This is a guide to how to operate the app if you ever have any trouble." 
                                       TextWrapping="WrapWithOverflow"
                                       Padding="5"
                                       />
                            </StackPanel>
                            <StackPanel>
                                <Expander Header="Home Page"
                                      VerticalAlignment="Center"
                                      Padding="5"
                                      >
                                          <!--ToolTip="Expand to See Information about the Home Page"-->
                                    <StackPanel>
                                        <TextBlock Text="The Home Page is a very important page in order to navigate and use AutoMeets properly."
                                               TextWrapping="WrapWithOverflow"
                                               Padding="5"
                                               />
                                        <Image Source="/Images/Help/Home Page/Home Page.png"
                                           HorizontalAlignment="Center" Height="365" Width="582"
                                           />
                                        <TextBlock Text="With one quick glance, you can find your upcoming class at the top of the page,"
                                               TextWrapping="WrapWithOverflow"
                                               Padding="5"
                                               />
                                        <Image Source="/Images/Help/Home Page/NextClassText.png"
                                           HorizontalAlignment="Center" Height="365" Width="582"
                                           />
                                        <TextBlock Text="If AutoMeets is checking or not in the center of the page,"
                                            TextWrapping="WrapWithOverflow"
                                            Padding="5"
                                            />
                                        <Image Source="/Images/Help/Home Page/CheckingText.png"
                                           HorizontalAlignment="Center" Height="365" Width="582"
                                           />
                                        <TextBlock Text="And random useful tips/bugs updated regularly at the bottom of the page."
                                                TextWrapping="WrapWithOverflow"
                                                Padding="5"
                                                />
                                        <Image Source="/Images/Help/Home Page/HelpText.png"
                                           HorizontalAlignment="Center" Height="365" Width="582"
                                           />
                                        <TextBlock Text="In addition, you can access all the pages of AutoMeets by looking for the buttons at the corners of the page."
                                            TextWrapping="WrapWithOverflow"
                                            Padding="5"
                                            />
                                        <Image Source="/Images/Help/Home Page/IconsHighlight.png"
                                           HorizontalAlignment="Center" Height="365" Width="582"
                                           />
                                        <TextBlock Text="The Top Left Button with a Wrench Icon accesses the Setup Page which you can use to change information about yourself or your class schedule. For more information, Please visit the Setup Page category on the Help Page."
                                               TextWrapping="WrapWithOverflow"
                                               Padding="5"
                                               />
                                        <Image Source="/Images/Help/Home Page/SetupIcon.png"
                                           HorizontalAlignment="Center" Height="365" Width="582"
                                           />
                                        <Image Source="/Images/Help/Setup/Setup.png"
                                           HorizontalAlignment="Center" Height="365" Width="582"
                                           />
                                        <TextBlock Text="The Top Right Button with a Gears Icon accesses the Settings Page which you can use to edit the Settings of AutoMeets. For more information, Please visit the Settings Page category on the Help Page."
                                               TextWrapping="WrapWithOverflow"
                                               Padding="5"
                                               />
                                        <Image Source="/Images/Help/Home Page/SettingsIcon.png"
                                           HorizontalAlignment="Center" Height="365" Width="582"
                                           />
                                        <Image Source="/Images/Help/Settings/Settings.png"
                                           HorizontalAlignment="Center" Height="365" Width="582"
                                           />
                                        <TextBlock Text="The Bottom Right Button with a Question Mark Icon accesses the Help Page which you can use to help understand how to use AutoMeets."
                                               TextWrapping="WrapWithOverflow"
                                               Padding="5"
                                               />
                                        <Image Source="/Images/Help/Home Page/HelpIcon.png"
                                           HorizontalAlignment="Center" Height="365" Width="582"
                                           />
                                        <!--<Image Source="/Images/Help//SettingsIcon.png"
                                           HorizontalAlignment="Center" Height="365" Width="582"
                                           />-->
                                        <!-- TODO: ADD HELP PAGE -->
                                    </StackPanel>
                                </Expander>
                                <Expander Header="Setup Page"
                                      VerticalAlignment="Center"
                                      Padding="5"
                                          ToolTip="Expand to See Information about the Setup Page"
                                      >
                                    <StackPanel>
                                        <TextBlock Text="The Setup Page is another very important page for AutoMeets. AutoMeets relys on the Setup Page in order to remind you about your classes on the right day and period."
                                               TextWrapping="WrapWithOverflow"
                                               Padding="5"
                                               />
                                        <Image Source="/Images/Help/Setup/Setup.png"
                                           HorizontalAlignment="Center" Height="365" Width="582"
                                           />
                                        <TextBlock Text="Every Sunday, AutoMeets will delete all of the information about last week's schedule and will prompt you to refill the page. Don't worry, if you are unable to or forget to open AutoMeets on Sunday, it will still delete your information the next time you boot it up and will also continuously prompt for you to fill out the Setup Page."
                                               TextWrapping="WrapWithOverflow"
                                               Padding="5"
                                               />
                                        <Image Source="/Images/Help/Setup/Sunday Setup Prompt With Highlight.png"
                                           HorizontalAlignment="Center" Height="365" Width="582"
                                           />
                                        <TextBlock Text="NOTE: AutoMeets will store all of your information locally onto your computer."
                                               TextWrapping="WrapWithOverflow"
                                               Padding="5"
                                               />
                                        <TextBlock Text="The Setup Page can also be used to update your School Email and Password along with your Class Periods."
                                               TextWrapping="WrapWithOverflow"
                                               Padding="5"
                                               />
                                        <Image Source="/Images/Help/Setup/SetupPersonal.png"
                                           HorizontalAlignment="Center" Height="365" Width="582"
                                           />
                                        <Image Source="/Images/Help/Setup/SetupBottomPeriod.png"
                                           HorizontalAlignment="Center" Height="365" Width="582"
                                           />
                                        <TextBlock Text="Every Sunday, AutoMeets will require you to fill out the This Week's Schedule section to help it plan the days it needs to remind you."
                                               TextWrapping="WrapWithOverflow"
                                               Padding="5"
                                               />
                                        <Image Source="/Images/Help/Setup/SetupWeek.png"
                                           HorizontalAlignment="Center" Height="365" Width="582"
                                           />
                                        <TextBlock Text="When it refers to How does this week start?, all you have to do is answer if the upcoming week will start with an Odd day (1-3-5) or an Even day (2-4-6)."
                                               TextWrapping="WrapWithOverflow"
                                               Padding="5"
                                               />
                                        <Image Source="/Images/Help/Setup/SetupOddEven.png"
                                           HorizontalAlignment="Center" Height="365" Width="582"
                                           />
                                        <TextBlock Text="When it refers to Which days do you not have school on?, simply look at the school calendar for that week to see if you have any holidays throughout the week or if you can't join school that day. Mark all the days that apply."
                                               TextWrapping="WrapWithOverflow"
                                               Padding="5"
                                               />
                                        <Image Source="/Images/Help/Setup/SetupSchoolNot.png"
                                           HorizontalAlignment="Center" Height="365" Width="582"
                                           />
                                        <TextBlock Text="In addition, every Sunday, AutoMeets will also require you to fill out the Friday section to help it figure out which class to connect you with for the Friday Connects."
                                               TextWrapping="WrapWithOverflow"
                                               Padding="5"
                                               />
                                        <Image Source="/Images/Help/Setup/SetupBottomFriday.png"
                                           HorizontalAlignment="Center" Height="365" Width="582"
                                           />
                                    </StackPanel>
                                </Expander>
                                <Expander Header="Settings Page"
                                      VerticalAlignment="Center"
                                      Padding="5"
                                          ToolTip="Expand to See Information about the Settings Page"
                                      >
                                    <StackPanel>
                                        <TextBlock Text="The Settings Page is another very important page for AutoMeets. The Settings Page is a way for you to customize AutoMeets to your liking."
                                               TextWrapping="WrapWithOverflow"
                                               Padding="5"
                                               />
                                        <Image Source="/Images/Help/Settings/Settings.png"
                                           HorizontalAlignment="Center" Height="365" Width="582"
                                           />
                                        <TextBlock Text="For example, you can tell AutoMeets whether it can start up when your computer starts up or not with a simple check mark box."
                                               TextWrapping="WrapWithOverflow"
                                               Padding="5"
                                               />
                                        <Image Source="/Images/Help/Settings/SettingsBoot.png"
                                           HorizontalAlignment="Center" Height="365" Width="582"
                                           />
                                        <TextBlock Text="You can also change how earlier AutoMeets will remind you to join class with the Remind Offset."
                                               TextWrapping="WrapWithOverflow"
                                               Padding="5"
                                               />
                                        <Image Source="/Images/Help/Settings/SettingsDelayTime.png"
                                           HorizontalAlignment="Center" Height="365" Width="582"
                                           />
                                        <TextBlock Text="Finally, you can also tell AutoMeets if you want to leave it disabled for the day by simply pressing the Disable button."
                                               TextWrapping="WrapWithOverflow"
                                               Padding="5"
                                               />
                                        <Image Source="/Images/Help/Settings/SettingsDisable.png"
                                           HorizontalAlignment="Center" Height="365" Width="582"
                                           />
                                    </StackPanel>
                                </Expander>
                                    <Expander Header="Join Class"
                                          VerticalAlignment="Center"
                                          Padding="5"
                                          >
                                        
                                    </Expander>
                                </StackPanel>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        >
                            <TextBlock Text="AutoMeets UI Update (2.0.0)"
                                       TextWrapping="WrapWithOverflow"
                                       Padding="5 0"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Bottom"
                                       />
                            <TextBlock Text="Designed by Kartik Yedumbaka in association with Mahavir Dondeti"
                                       TextWrapping="WrapWithOverflow"
                                           FontSize="10"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Bottom"
                                       />
                        </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
