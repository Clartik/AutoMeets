<local:BasePage x:TypeArguments="local:SetupPageViewModel"  x:Class="AutoMeetsUI.SetupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AutoMeetsUI"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800">

    <Border Padding="5" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock x:Name="PageTitle"
                               Text="Setup"
                               FontSize="30"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Padding="5"
                               />
            </Grid>

            <Border Padding="10" Grid.Row="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- First Half 1 to 3-->
                        <StackPanel Grid.Column="0">
                            <!-- Info -->
                            <StackPanel>
                                <TextBlock x:Name="InfoText"
                                           Text="Info"
                                           FontSize="15"
                                           Padding="5"
                                           Foreground="Gray"
                                           VerticalAlignment="Center"
                                           />

                                <!-- Gmail Info -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="GmailText"
                                               Text="School Email:"
                                               Padding="5"
                                               VerticalAlignment="Center"
                                               />
                                    <TextBox x:Name="EmailInput"
                                             Text="{Binding Email}"
                                             Width="175"
                                             Background="LightGray"
                                             VerticalAlignment="Center"
                                             />
                                </StackPanel>

                                <!-- Password -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="PasswordText"
                                               Text="School Password:"
                                               Padding="5"
                                               VerticalAlignment="Center"
                                               />
                                    <TextBox x:Name="PasswordInput"
                                             Text="{Binding Password}"
                                             Width="175"
                                             Background="LightGray"
                                             VerticalAlignment="Center"
                                             />
                                </StackPanel>

                                <!-- Confirm Password -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="ConfirmPasswordText"
                                               Text="Confirm School Password:"
                                               Padding="5"
                                               VerticalAlignment="Center"
                                               />
                                    <TextBox x:Name="ConfirmPasswordInput"
                                             Text="{Binding ConfirmPassword}"
                                             Width="175"
                                             Background="LightGray"
                                             VerticalAlignment="Center"
                                             />
                                </StackPanel>

                                <Separator Height="8"
                                           Background="White"
                                           />
                            </StackPanel>

                            <!-- Period 1 -->
                            <StackPanel>
                                <TextBlock x:Name="Period1Title"
                                            Text="Period 1"
                                            FontSize="15"
                                            Padding="5"
                                            Foreground="Gray"
                                            />

                                <!-- Period 1 Name -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Period1NameText"
                                                Text="Period 1 Name:"
                                                Padding="5"
                                                VerticalAlignment="Center"
                                                />
                                    <TextBox x:Name="Period1NameInput"
                                             Text="{Binding Per1Name}"
                                             Width="175"
                                             Background="LightGray"
                                             VerticalAlignment="Center"
                                             />
                                </StackPanel>
                                <!-- Period 1 Meet Code -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Period1CodeText"
                                                Text="Period 1 Meet Code/Link:"
                                                Padding="5"
                                                VerticalAlignment="Center"
                                                />
                                    <TextBox x:Name="Period1CodeInput"
                                             Text="{Binding Per1Code}"
                                             Width="150"
                                             Background="LightGray"
                                             VerticalAlignment="Center"
                                             />
                                </StackPanel>
                            </StackPanel>
                            <!-- Period 2 -->
                            <StackPanel>
                                <TextBlock x:Name="Period2Title"
                                   Text="Period 2"
                                   FontSize="15"
                                   Padding="5"
                                   Foreground="Gray"
                                   />

                                <!-- Period 2 Name -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Period2NameText"
                                        Text="Period 2 Name:"
                                        Padding="5"
                                        VerticalAlignment="Center"
                                        />
                                    <TextBox x:Name="Period2NameInput"
                                             Text="{Binding Per2Name}"
                                         Width="175"
                                         Background="LightGray"
                                         VerticalAlignment="Center"
                                         />
                                </StackPanel>
                                <!-- Period 2 Meet Code -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Period2CodeText"
                                        Text="Period 2 Meet Code/Link:"
                                        Padding="5"
                                        VerticalAlignment="Center"
                                        />
                                    <TextBox x:Name="Period2CodeInput"
                                             Text="{Binding Per2Code}"
                                         Width="150"
                                         Background="LightGray"
                                         VerticalAlignment="Center"
                                         />
                                </StackPanel>
                            </StackPanel>
                            <!-- Period 3 -->
                            <StackPanel>
                                <TextBlock x:Name="Period3Title"
                                   Text="Period 3"
                                   FontSize="15"
                                   Padding="5"
                                   Foreground="Gray"
                                   />

                                <!-- Period 3 Name -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Period3NameText"
                                        Text="Period 3 Name:"
                                        Padding="5"
                                        VerticalAlignment="Center"
                                        />
                                    <TextBox x:Name="Period3NameInput"
                                             Text="{Binding Per3Name}"
                                         Width="175"
                                         Background="LightGray"
                                         VerticalAlignment="Center"
                                         />
                                </StackPanel>
                                <!-- Period 3 Meet Code -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Period3CodeText"
                                                Text="Period 3 Meet Code/Link:"
                                                Padding="5"
                                                VerticalAlignment="Center"
                                                />
                                    <TextBox x:Name="Period3CodeInput"
                                             Text="{Binding Per3Code}"
                                             Width="150"
                                             Background="LightGray"
                                             VerticalAlignment="Center"
                                             />
                                </StackPanel>
                            </StackPanel>
                            <!-- Friday -->
                            <StackPanel>
                                <TextBlock x:Name="FridayTitle"
                                               Text="Friday"
                                               FontSize="15"
                                               Padding="5"
                                               Foreground="Gray"
                                               />

                                <!-- Friday Text and Options -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="FridayText"
                                                            Text="Which class do you have this Friday?"
                                                            Padding="5"
                                                            VerticalAlignment="Top"
                                                            />

                                    <!-- Padding between buttons -->
                                    <StackPanel Orientation="Vertical">
                                        <Border Padding="2">
                                            <ToggleButton x:Name="FridayP1Button"
                                                    Content="Per 1"
                                                    Padding="5"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding FridayPer1Command}"
                                                          IsChecked="{Binding FridayPer1Checked}"
                                                    />
                                        </Border>
                                        <Border Padding="2">
                                            <ToggleButton x:Name="FridayP4Button"
                                                        Content="Per 4"
                                                        Padding="5"
                                                        VerticalAlignment="Center"
                                                    Command="{Binding FridayPer4Command}"
                                                          IsChecked="{Binding FridayPer4Checked}"
                                                        />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Vertical">
                                        <Border Padding="2">
                                            <ToggleButton x:Name="FridayP2Button"
                                                        Content="Per 2"
                                                        Padding="5"
                                                        VerticalAlignment="Center"
                                                    Command="{Binding FridayPer2Command}"
                                                          IsChecked="{Binding FridayPer2Checked}"
                                                        />
                                        </Border>
                                        <Border Padding="2">
                                            <ToggleButton x:Name="FridayP5Button"
                                                        Content="Per 5"
                                                        Padding="5"
                                                        VerticalAlignment="Center"
                                                    Command="{Binding FridayPer5Command}"
                                                          IsChecked="{Binding FridayPer5Checked}"
                                                        />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Vertical">
                                        <Border Padding="2">
                                            <ToggleButton x:Name="FridayP3Button"
                                                    Content="Per 3"
                                                    Padding="5"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding FridayPer3Command}"
                                                          IsChecked="{Binding FridayPer3Checked}"
                                                     />
                                        </Border>
                                        <Border Padding="2">
                                            <ToggleButton x:Name="FridayP6Button"
                                                        Content="Per 6"
                                                        Padding="5"
                                                        VerticalAlignment="Center"
                                                    Command="{Binding FridayPer6Command}"
                                                          IsChecked="{Binding FridayPer6Checked}"
                                                        />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Second Half 4 to 6-->
                        <StackPanel Grid.Column="1">
                            <!-- Week Schedule -->
                            <StackPanel>
                                <TextBlock x:Name="WeekScheduleTitle"
                                   Text="This Week's Schedule"
                                   FontSize="15"
                                   Padding="5"
                                   Foreground="Gray"
                                   />
                                <!-- Odd or Even Week Start -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="OddorEvenText"
                                           Text="How does this week start?"
                                           Padding="5"
                                           VerticalAlignment="Center"
                                           />
                                    <!-- Buttons with Padding -->
                                    <StackPanel Orientation="Horizontal">
                                        <Border Padding="2">
                                            <ToggleButton x:Name="OddButton"
                                                          Content="Odd"
                                                          Padding="5"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding OddChecked}"
                                                          Command="{Binding OddCommand}"
                                                          />
                                        </Border>
                                        <Border Padding="2">
                                            <ToggleButton x:Name="EvenButton"
                                                          Content="Even"
                                                          Padding="5"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding EvenChecked}"
                                                          Command="{Binding EvenCommand}"
                                                          />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <!-- Days Off -->
                                <StackPanel Orientation="Vertical">
                                    <TextBlock x:Name="DaysOffText"
                                           Text="Which days do you not have school on?"
                                           Padding="5"
                                           VerticalAlignment="Top"
                                           />
                                    <StackPanel Orientation="Horizontal">
                                        <Border Padding="2">
                                            <ToggleButton x:Name="MondayButton"
                                                          Content="Monday"
                                                          Padding="5"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding MondayChecked}"
                                                          />
                                        </Border>
                                        <Border Padding="2">
                                            <ToggleButton x:Name="TuesdayButton"
                                                          Content="Tuesday"
                                                          Padding="5"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding TuesdayChecked}"
                                                          />
                                        </Border>
                                        <Border Padding="2">
                                            <ToggleButton x:Name="WednesdayButton"
                                                          Content="Wednesday"
                                                          Padding="5"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding WednesdayChecked}"
                                                          />
                                        </Border>
                                        <Border Padding="2">
                                            <ToggleButton x:Name="ThursdayButton"
                                                          Content="Thursday"
                                                          Padding="5"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding ThursdayChecked}"
                                                          />
                                        </Border>
                                        <Border Padding="2">
                                            <ToggleButton x:Name="FridayButton"
                                                          Content="Friday"
                                                          Padding="5"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding FridayChecked}"
                                                          />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- Period 4 -->
                            <StackPanel>
                                <TextBlock x:Name="Period4Title"
                                                   Text="Period 4"
                                                   FontSize="15"
                                                   Padding="5"
                                                   Foreground="Gray"
                                                   />

                                <!-- Period 4 Name -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Period4NameText"
                                                        Text="Period 4 Name:"
                                                        Padding="5"
                                                        VerticalAlignment="Center"
                                                        />
                                    <TextBox x:Name="Period4NameInput"
                                                     Text="{Binding Per4Name}"
                                                     Width="175"
                                                     Background="LightGray"
                                                     VerticalAlignment="Center"
                                                     />
                                </StackPanel>
                                <!-- Period 4 Meet Code -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Period4CodeText"
                                                        Text="Period 4 Meet Code/Link:"
                                                        Padding="5"
                                                        VerticalAlignment="Center"
                                                        />
                                    <TextBox x:Name="Period4CodeInput"
                                                     Text="{Binding Per4Code}"
                                                     Width="150"
                                                     Background="LightGray"
                                                     VerticalAlignment="Center"
                                                     />
                                </StackPanel>
                            </StackPanel>
                            <!-- Period 5 -->
                            <StackPanel>
                                <TextBlock x:Name="Period5Title"
                                                   Text="Period 5"
                                                   FontSize="15"
                                                   Padding="5"
                                                   Foreground="Gray"
                                                   />

                                <!-- Period 5 Name -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Period5NameText"
                                        Text="Period 5 Name:"
                                        Padding="5"
                                        VerticalAlignment="Center"
                                        />
                                    <TextBox x:Name="Period5NameInput"
                                             Text="{Binding Per5Name}"
                                         Width="175"
                                         Background="LightGray"
                                         VerticalAlignment="Center"
                                         />
                                </StackPanel>
                                <!-- Period 5 Meet Code -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Period5CodeText"
                                        Text="Period 5 Meet Code/Link:"
                                        Padding="5"
                                        VerticalAlignment="Center"
                                        />
                                    <TextBox x:Name="Period5CodeInput"
                                             Text="{Binding Per5Code}"
                                         Width="150"
                                         Background="LightGray"
                                         VerticalAlignment="Center"
                                         />
                                </StackPanel>
                            </StackPanel>
                            <!-- Period 6 -->
                            <StackPanel>
                                <TextBlock x:Name="Period6Title"
                                   Text="Period 6"
                                   FontSize="15"
                                   Padding="5"
                                   Foreground="Gray"
                                   />

                                <!-- Period 6 Name -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Period6NameText"
                                        Text="Period 6 Name:"
                                        Padding="5"
                                        VerticalAlignment="Center"
                                        />
                                    <TextBox x:Name="Period6NameInput"
                                             Text="{Binding Per6Name}"
                                         Width="175"
                                         Background="LightGray"
                                         VerticalAlignment="Center"
                                         />
                                </StackPanel>
                                <!-- Period 6 Meet Code -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Period6CodeText"
                                        Text="Period 6 Meet Code/Link:"
                                        Padding="5"
                                        VerticalAlignment="Center"
                                        />
                                    <TextBox x:Name="Period6CodeInput"
                                             Text="{Binding Per6Code}"
                                         Width="150"
                                         Background="LightGray"
                                         VerticalAlignment="Center"
                                         />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="2">
                <Button x:Name="Save"
                        Content="Save"
                        Padding="10 5"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Center"
                        Command="{Binding SaveCommand}"
                        />
            </Grid>
        </Grid>
    </Border>
</local:BasePage>
