<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:AutoMeetsUI"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">

    <!--<FontFamily x:Key="FontAwesomeRegular">pack://application;,,,/Fonts/#Font Awesome 5 Free Regular</FontFamily>-->
    <FontFamily x:Key="FontAwesome">pack://application:,,,/Fonts/#Font Awesome 5 Free Solid</FontFamily>

    <system:Double x:Key="FontSizeSmaller">10</system:Double>
    <system:Double x:Key="FontSizeSmall">12</system:Double>
    <system:Double x:Key="FontSizeRegular">14</system:Double>
    <system:Double x:Key="FontSizeLarge">20</system:Double>
    <system:Double x:Key="FontSizeXLarge">24</system:Double>
    <system:Double x:Key="FontSizeXXLarge">30</system:Double>

    <system:String x:Key="FontAwesomeSetupIcon">&#xf0ad;</system:String>
    <system:String x:Key="FontAwesomeSettingsIcon">&#xf013;</system:String>
    <system:String x:Key="FontAwesomeHelpIcon">&#xf059;</system:String>
    <system:String x:Key="FontAwesomeBackArrowIcon">&#xf060;</system:String>

    <system:String x:Key="FontAwesomeRightBackArrowIcon">&#xf054;</system:String>
    <system:String x:Key="FontAwesomeLeftBackArrowIcon">&#xf053;</system:String>
    <system:String x:Key="FontAwesomeUpBackArrowIcon">&#xf077;</system:String>

</ResourceDictionary>