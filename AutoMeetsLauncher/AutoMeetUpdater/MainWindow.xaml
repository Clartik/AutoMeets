<Window x:Class="AutoMeetUpdater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoMeetUpdater"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        ContentRendered="Window_ContentRendered"
        WindowStyle="None"
        AllowsTransparency="True"
        BorderThickness="0"
        Background="Transparent"
        Title="AutoMeets Updater" Height="400" Width="400">
    <Border Background="White" CornerRadius="20" BorderThickness="2" BorderBrush="Gray">
        <Grid>
            <Border x:Name="Mask" CornerRadius="20" Background="White" />

            <Border Background="#aa91e5">
                <Border.OpacityMask>
                    <VisualBrush Visual="{Binding ElementName=Mask}" />
                </Border.OpacityMask>
                <Image HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="UniformToFill" Source="/images/Background.png" Opacity="0.85"/>
                
            </Border>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Padding="22" CornerRadius="20">
                    <Image Source="/images/AutoMeets_Icon.png"
                            Stretch="Uniform"
                            x:Name="AutoMeetLogo"
                            Grid.Row="0"
                            Visibility="Visible"
                            Opacity="0"
                            />
                </Border>

                <Grid Grid.Row="1">
                    <ProgressBar x:Name="ProgressBar"
                                Width="350"
                                Height="25"
                                Minimum="0"
                                Maximum="100"
                                Background="White"
                                Foreground="LightSkyBlue"
                    />
                    <Grid.Effect>
                        <DropShadowEffect BlurRadius="5" ShadowDepth="2" Direction="-50" Opacity="0.6" />
                    </Grid.Effect>
                </Grid>

                <StackPanel Grid.Row="2">
                    <TextBlock x:Name="UpdateText"
                            Text="Checking for Updates"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="15"
                            Foreground="White"
                            Background="#59000000"
                            Padding="11 10"
                            Grid.Row="2"
                />

                    <TextBlock x:Name="MBText"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            FontSize="14"
                            Foreground="White"
                            Grid.Row="2"
                            Padding="11 10"
                />
                </StackPanel>

                <TextBlock x:Name="VersionText"
                           Text="1.1.0"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Right"
                        FontSize="12"
                        Foreground="White"
                        Padding="10"
                        Grid.Row="2"
                />
            </Grid>
        </Grid>
    </Border>
</Window>
