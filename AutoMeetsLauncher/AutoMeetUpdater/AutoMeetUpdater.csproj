<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>netcoreapp3.1</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>images\favicon.ico</ApplicationIcon>
    <AssemblyName>AutoMeetsUpdater</AssemblyName>
    <RootNamespace>AutoMeetsUpdater</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="images\AutoMeets_Icon.png" />
    <None Remove="images\Background.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ByteSize" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="images\AutoMeets_Icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="images\Background.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

</Project>